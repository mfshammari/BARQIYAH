# ————— Supabase —————
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ————— WhatsApp / Meta Cloud API —————
# اتركها فارغة لتشغيل وضع المحاكاة (Mock) تلقائياً
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# سرّ التطبيق (App Secret) للتحقق من توقيع X-Hub-Signature-256 — بدونه يُقبل
# الـwebhook بلا توقيع في التطوير فقط، ويُرفض في الإنتاج
META_APP_SECRET=

# ————— بوابة الدفع (Moyasar) —————
# اتركها فارغة ليبقى التفعيل يدوياً من لوحة الأدمن
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# ————— التطبيق —————
APP_URL=http://localhost:3000
# يحمي مسارات cron (مثل /api/cron/expire) — Vercel ترسله في ترويسة Authorization
CRON_SECRET=
